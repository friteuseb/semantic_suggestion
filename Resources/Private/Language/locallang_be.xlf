<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<xliff version="1.0">
    <file source-language="en" datatype="plaintext" original="messages" date="2023-07-16T12:00:00Z" product-name="semantic_suggestion">
        <header/>
        <body>
            <trans-unit id="plugin.title">
                <source>Semantic Suggestions</source>
            </trans-unit>
            <trans-unit id="plugin.description">
                <source>Suggests semantically related pages</source>
            </trans-unit>
            <trans-unit id="flexforms.parentPageId">
                <source>Parent Page ID</source>
            </trans-unit>
            <trans-unit id="flexforms.proximityThreshold">
                <source>Proximity Threshold</source>
            </trans-unit>

            <!-- Backend Module Translations -->
            <trans-unit id="backend.title">
                <source>Semantic Suggestion - Backend Analysis</source>
            </trans-unit>
            <trans-unit id="backend.title.legacy">
                <source>Semantic Suggestion - Backend Analysis (v12)</source>
            </trans-unit>

            <!-- Error Messages -->
            <trans-unit id="backend.error.no_analysis">
                <source>No analysis available</source>
            </trans-unit>
            <trans-unit id="backend.error.no_analysis.message">
                <source>No similarity analysis found. Please configure and run the "Semantic Suggestion: Generate Similarities" scheduler task.</source>
            </trans-unit>

            <!-- Configuration Instructions -->
            <trans-unit id="backend.config.required">
                <source>Required configuration:</source>
            </trans-unit>
            <trans-unit id="backend.config.step1">
                <source>Go to the <strong>System > Scheduler</strong> module</source>
            </trans-unit>
            <trans-unit id="backend.config.step2">
                <source>Create a new <strong>"Semantic Suggestion: Generate Similarities"</strong> task</source>
            </trans-unit>
            <trans-unit id="backend.config.step3">
                <source>Configure the parameters:</source>
            </trans-unit>
            <trans-unit id="backend.config.param.start_page">
                <source><strong>Start Page ID</strong>: Root page ID for analysis (e.g.: 1)</source>
            </trans-unit>
            <trans-unit id="backend.config.param.threshold">
                <source><strong>Minimum similarity threshold</strong>: Storage threshold (e.g.: 0.1)</source>
            </trans-unit>
            <trans-unit id="backend.config.param.exclude">
                <source><strong>Pages to exclude</strong>: Pages to exclude (optional)</source>
            </trans-unit>
            <trans-unit id="backend.config.step4">
                <source>Schedule execution (daily/weekly during off-peak hours)</source>
            </trans-unit>
            <trans-unit id="backend.config.step5">
                <source>Run the task once for the first time</source>
            </trans-unit>
            <trans-unit id="backend.config.note">
                <source><strong>Note:</strong> The first execution may take time depending on the number of pages to analyze.</source>
            </trans-unit>

            <!-- Analysis Selection -->
            <trans-unit id="backend.analysis.selection">
                <source>Analysis selection</source>
            </trans-unit>
            <trans-unit id="backend.analysis.available">
                <source>Available Scheduler analysis</source>
            </trans-unit>
            <trans-unit id="backend.analysis.help">
                <source>Each analysis corresponds to a Scheduler task execution with a specific Start Page ID.</source>
            </trans-unit>
            <trans-unit id="backend.refresh">
                <source>Refresh</source>
            </trans-unit>

            <!-- Analysis Configuration -->
            <trans-unit id="backend.analysis.config">
                <source>Selected analysis configuration</source>
            </trans-unit>
            <trans-unit id="backend.analysis.start_page">
                <source>Start Page ID</source>
            </trans-unit>
            <trans-unit id="backend.analysis.start_page.help">
                <source>Configured in Scheduler</source>
            </trans-unit>
            <trans-unit id="backend.analysis.pages_analyzed">
                <source>Analyzed pages</source>
            </trans-unit>
            <trans-unit id="backend.analysis.pages_analyzed.help">
                <source>With at least one similarity</source>
            </trans-unit>
            <trans-unit id="backend.analysis.stored_pairs">
                <source>Stored pairs</source>
            </trans-unit>
            <trans-unit id="backend.analysis.stored_pairs.help">
                <source>Above Scheduler threshold</source>
            </trans-unit>
            <trans-unit id="backend.analysis.display_threshold">
                <source>Display threshold</source>
            </trans-unit>
            <trans-unit id="backend.analysis.display_threshold.help">
                <source>TypoScript, or the default when no TypoScript is found</source>
            </trans-unit>
            <trans-unit id="backend.analysis.max_suggestions">
                <source>Max frontend suggestions</source>
            </trans-unit>
            <trans-unit id="backend.analysis.max_suggestions.help">
                <source>Display limit</source>
            </trans-unit>
            <trans-unit id="backend.analysis.pages_with_similarities">
                <source>Pages with similarities</source>
            </trans-unit>
            <trans-unit id="backend.analysis.pages_with_similarities.help">
                <source>In current results</source>
            </trans-unit>
            <trans-unit id="backend.analysis.excluded_pages">
                <source>Excluded pages (display)</source>
            </trans-unit>
            <trans-unit id="backend.analysis.excluded_pages.yes">
                <source>Yes</source>
            </trans-unit>
            <trans-unit id="backend.analysis.excluded_pages.none">
                <source>None</source>
            </trans-unit>
            <trans-unit id="backend.analysis.excluded_pages.none_help">
                <source>No exclusion</source>
            </trans-unit>

            <!-- Performance Metrics -->
            <trans-unit id="backend.performance.title">
                <source>Performance metrics</source>
            </trans-unit>
            <trans-unit id="backend.performance.execution_time">
                <source>Loading time</source>
            </trans-unit>
            <trans-unit id="backend.performance.execution_time.help">
                <source>Backend module</source>
            </trans-unit>
            <trans-unit id="backend.performance.database_pairs">
                <source>Database pairs</source>
            </trans-unit>
            <trans-unit id="backend.performance.database_pairs.help">
                <source>For this analysis</source>
            </trans-unit>

            <!-- Language Statistics -->
            <trans-unit id="backend.language.title">
                <source>Language statistics</source>
            </trans-unit>
            <trans-unit id="backend.language.table.language">
                <source>Language</source>
            </trans-unit>
            <trans-unit id="backend.language.table.pages">
                <source>Pages</source>
            </trans-unit>
            <trans-unit id="backend.language.table.percentage">
                <source>Percentage</source>
            </trans-unit>
            <trans-unit id="backend.language.help">
                <source>Statistics based on pages with at least one similarity in the selected analysis.</source>
            </trans-unit>

            <!-- Top Similar Pairs -->
            <trans-unit id="backend.top_pairs.title">
                <source>Top 5 most similar pairs</source>
            </trans-unit>
            <trans-unit id="backend.top_pairs.page1">
                <source>Page 1</source>
            </trans-unit>
            <trans-unit id="backend.top_pairs.page2">
                <source>Page 2</source>
            </trans-unit>
            <trans-unit id="backend.top_pairs.similarity_score">
                <source>Similarity score</source>
            </trans-unit>

            <!-- Top Similar Pages -->
            <trans-unit id="backend.top_pages.title">
                <source>Top 5 pages with most similarities</source>
            </trans-unit>
            <trans-unit id="backend.top_pages.page">
                <source>Page</source>
            </trans-unit>
            <trans-unit id="backend.top_pages.similar_count">
                <source>Number of similar pages</source>
            </trans-unit>

            <!-- General Statistics -->
            <trans-unit id="backend.statistics.title">
                <source>General statistics</source>
            </trans-unit>
            <trans-unit id="backend.statistics.total_pairs">
                <source>Similarity pairs</source>
            </trans-unit>
            <trans-unit id="backend.statistics.total_pairs.help">
                <source>Stored above threshold</source>
            </trans-unit>
            <trans-unit id="backend.statistics.total_pages">
                <source>Pages with similarities</source>
            </trans-unit>
            <trans-unit id="backend.statistics.total_pages.help">
                <source>Having at least one relationship</source>
            </trans-unit>

            <!-- Footer Information -->
            <trans-unit id="backend.info.configuration">
                <source>Configuration</source>
            </trans-unit>
            <trans-unit id="backend.info.scheduler">
                <source><strong>Scheduler:</strong> Configure analysis (Start Page ID, storage threshold)</source>
            </trans-unit>
            <trans-unit id="backend.info.typoscript">
                <source><strong>TypoScript:</strong> Configure frontend display (display threshold, max number)</source>
            </trans-unit>
            <trans-unit id="backend.info.database">
                <source><strong>Database:</strong> Persistent storage of similarities</source>
            </trans-unit>
            <trans-unit id="backend.tips.title">
                <source>Tips</source>
            </trans-unit>
            <trans-unit id="backend.tips.scheduler">
                <source>Run Scheduler during off-peak hours</source>
            </trans-unit>
            <trans-unit id="backend.tips.threshold">
                <source>Scheduler threshold ≤ TypoScript threshold</source>
            </trans-unit>
            <trans-unit id="backend.tips.performance">
                <source>Monitor performance for large sites</source>
            </trans-unit>

            <!-- Flash Messages -->
            <trans-unit id="backend.flash.no_analysis_found">
                <source>No similarity analysis found. Please configure and run the "Semantic Suggestion: Generate Similarities" scheduler task.</source>
            </trans-unit>
            <trans-unit id="backend.flash.no_data_available">
                <source>No data available</source>
            </trans-unit>
            <trans-unit id="backend.flash.module_error">
                <source>An error occurred while loading the module. Check the logs: %s</source>
            </trans-unit>
            <trans-unit id="backend.flash.error">
                <source>Error</source>
            </trans-unit>

            <!-- Scheduler Task Translations -->
            <trans-unit id="scheduler.task.start_page_id">
                <source>Start Page ID (Analysis starting point)</source>
            </trans-unit>
            <trans-unit id="scheduler.task.exclude_pages">
                <source>Pages to exclude (comma separated)</source>
            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion">
                <source>Recursive exclusion</source>
            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion.help">
                <source>Exclude recursively sub-pages</source>
            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion.description">
                <source>If checked: exclude the page AND all its sub-pages<br/>If unchecked: exclude only the page, but analyze its sub-pages</source>
            </trans-unit>
            <trans-unit id="scheduler.task.minimum_similarity">
                <source>Minimum similarity threshold (0-1)</source>
            </trans-unit>
            <trans-unit id="scheduler.task.quality_level">
                <source>Quality Level (0.05-1.0) - Unified threshold for storage and display</source>
            </trans-unit>
            <trans-unit id="scheduler.task.storage_quality_level">
                <source>Storage Quality Level (0.05-1.0) - Controls what similarities get stored in database</source>
            </trans-unit>
            <trans-unit id="scheduler.task.storage_quality_level.description">
                <source>Defines the minimum similarity score for storing page pairs. Storage threshold = Quality Level (direct mapping). Example: 0.1 stores pairs ≥ 0.1. Pages on the same topic typically score 0.1 to 0.3. Higher values = better performance but fewer stored pairs.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_quality_level">
                <source>The quality level must be between 0.1 and 1.0.</source>
            </trans-unit>

            <!-- Scheduler Validation Messages -->
            <trans-unit id="scheduler.validation.invalid_start_page">
                <source>The start page ID must be a positive integer.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_similarity">
                <source>The similarity threshold must be a value between 0 and 1.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_exclude_pages">
                <source>The exclude pages list must contain only valid page IDs (positive integers).</source>
            </trans-unit>

            <!-- Scheduler Additional Information -->
            <trans-unit id="scheduler.info.start_page">
                <source>Start page</source>
            </trans-unit>
            <trans-unit id="scheduler.info.excluded_pages">
                <source>Excluded pages</source>
            </trans-unit>
            <trans-unit id="scheduler.info.none">
                <source>none</source>
            </trans-unit>
            <trans-unit id="scheduler.info.exclusion">
                <source>Exclusion</source>
            </trans-unit>
            <trans-unit id="scheduler.info.recursive">
                <source>Recursive</source>
            </trans-unit>
            <trans-unit id="scheduler.info.page_only">
                <source>Page only</source>
            </trans-unit>
            <trans-unit id="scheduler.info.minimum_threshold">
                <source>Minimum threshold</source>
            </trans-unit>
            <trans-unit id="scheduler.info.quality_level">
                <source>Quality Level</source>
            </trans-unit>
            <trans-unit id="scheduler.info.storage_threshold">
                <source>Storage Threshold</source>
            </trans-unit>
            <trans-unit id="scheduler.info.language">
                <source>Language</source>
            </trans-unit>
            <trans-unit id="scheduler.info.all_languages">
                <source>All languages</source>
            </trans-unit>

            <!-- Scheduler Task Registration -->
            <trans-unit id="scheduler.task.title">
                <source>Semantic Suggestion: Generate Similarities</source>
            </trans-unit>
            <trans-unit id="scheduler.task.description">
                <source>Analyzes site pages and generates semantic similarity relationships for content recommendations</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.title">
                <source>Link opportunities</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.help">
                <source>Similar pages that do not link to each other yet (default language). Pages that no other page links to come first.</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.summary">
                <source>Among the 5 closest pages of each page, above the display threshold: %1$s pairs, %2$s already linked, %3$s to add. Orphan pages: %4$s (with a similar page to link from: %5$s).</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.source">
                <source>Add a link on</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.target">
                <source>Pointing to</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.incoming">
                <source>Links received</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.orphan">
                <source>Orphan</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.none">
                <source>Every similar pair already links.</source>
            </trans-unit>
            <trans-unit id="backend.link_opportunities.edit">
                <source>Open this page in the Layout module</source>
            </trans-unit>
        </body>
    </file>
</xliff>
