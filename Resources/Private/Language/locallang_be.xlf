            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion">
                <source>Recursive exclusion</source>
            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion.help">
                <source>Exclude recursively sub-pages</source>
            </trans-unit>
            <trans-unit id="scheduler.task.recursive_exclusion.description">
                <source>If checked: exclude the page AND all its sub-pages<br/>If unchecked: exclude only the page, but analyze its sub-pages</source>
            </trans-unit>
            <trans-unit id="scheduler.task.minimum_similarity">
                <source>Minimum similarity threshold (0-1)</source>
            </trans-unit>
            <trans-unit id="scheduler.task.quality_level">
                <source>Quality Level (0.05-1.0) - Unified threshold for storage and display</source>
            </trans-unit>
            <trans-unit id="scheduler.task.storage_quality_level">
                <source>Storage Quality Level (0.05-1.0) - Controls what similarities get stored in database</source>
            </trans-unit>
            <trans-unit id="scheduler.task.storage_quality_level.description">
                <source>Defines the minimum similarity score for storing page pairs. Storage threshold = Quality Level (direct mapping). Example: 0.1 stores pairs ≥ 0.1. Pages on the same topic typically score 0.1 to 0.3. Higher values = better performance but fewer stored pairs.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_quality_level">
                <source>The quality level must be between 0.1 and 1.0.</source>
            </trans-unit>

            <!-- Scheduler Validation Messages -->
            <trans-unit id="scheduler.validation.invalid_start_page">
                <source>The start page ID must be a positive integer.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_similarity">
                <source>The similarity threshold must be a value between 0 and 1.</source>
            </trans-unit>
            <trans-unit id="scheduler.validation.invalid_exclude_pages">
                <source>The exclude pages list must contain only valid page IDs (positive integers).</source>
